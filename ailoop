#!/usr/bin/env node

//
// ailoop — Minimal AI agent loop extracted from OpenClaw's core logic.
//
// Reads a task from stdin, runs a tool-use loop against an OpenAI-compatible
// API (default: Ollama qwen3:8b), prints the final reply to stdout.
//
// Usage:
//   echo "What time is it in Tokyo?" | node ailoop
//   echo "Fetch https://httpbin.org/ip and tell me my IP" | node ailoop
//   echo "Calculate sqrt(144) * 3 + 7" | node ailoop
//   echo "What is 2+2?" | node ailoop --model gpt-4o --base-url https://api.openai.com/v1
//
// Environment variables:
//   OLLAMA_HOST      Ollama base URL             (default: http://localhost:11434)
//   OPENAI_BASE_URL  Override API base URL        (takes precedence over OLLAMA_HOST)
//   OPENAI_API_KEY   Bearer token for the API     (default: "" for Ollama)
//   AILOOP_MODEL     Model name                   (default: qwen3:8b)
//   AILOOP_MAX_ROUNDS  Max tool-call rounds       (default: 15)
//   AILOOP_TIMEOUT   Total timeout in seconds     (default: 300)
//   AILOOP_VERBOSE   Set to 1 for debug output    (default: 0)
//

"use strict";

// ─── Helpers ────────────────────────────────────────────────────────────────

const log = (...a) => {
  if (process.env.AILOOP_VERBOSE === "1") process.stderr.write("[ailoop] " + a.join(" ") + "\n");
};

function die(msg) {
  process.stderr.write("error: " + msg + "\n");
  process.exit(1);
}

function parseArgs(argv) {
  const args = { model: null, baseUrl: null, apiKey: null, maxRounds: null, timeout: null };
  for (let i = 2; i < argv.length; i++) {
    const a = argv[i];
    if ((a === "--model" || a === "-m") && argv[i + 1]) args.model = argv[++i];
    else if ((a === "--base-url" || a === "-u") && argv[i + 1]) args.baseUrl = argv[++i];
    else if ((a === "--api-key" || a === "-k") && argv[i + 1]) args.apiKey = argv[++i];
    else if (a === "--max-rounds" && argv[i + 1]) args.maxRounds = parseInt(argv[++i], 10);
    else if (a === "--timeout" && argv[i + 1]) args.timeout = parseInt(argv[++i], 10);
    else if (a === "--verbose" || a === "-v") process.env.AILOOP_VERBOSE = "1";
    else if (a === "--help" || a === "-h") {
      process.stdout.write(
        `ailoop — Minimal AI agent tool-use loop (OpenClaw core logic extract)

Usage:
  echo "your task" | node ailoop [options]

Options:
  -m, --model <name>      Model name        (default: qwen3:8b / $AILOOP_MODEL)
  -u, --base-url <url>    API base URL      (default: http://localhost:11434/v1)
  -k, --api-key <key>     API bearer token  (default: "" for Ollama)
      --max-rounds <n>    Max tool rounds   (default: 15)
      --timeout <sec>     Timeout seconds   (default: 300)
  -v, --verbose           Debug output to stderr
  -h, --help              Show this help

Tools available: shell, fetch, datetime, calculate, read_file, write_file, ls

Examples:
  echo "List files in /tmp" | node ailoop
  echo "What is the weather API response from wttr.in/Tokyo?format=j1" | node ailoop
  echo "Calculate 2^10 * 3.14" | node ailoop
`
      );
      process.exit(0);
    }
  }
  return args;
}

function readStdin() {
  return new Promise((resolve, reject) => {
    if (process.stdin.isTTY) {
      die("No input on stdin. Pipe a message: echo \"your task\" | node ailoop");
    }
    const chunks = [];
    process.stdin.setEncoding("utf8");
    process.stdin.on("data", (c) => chunks.push(c));
    process.stdin.on("end", () => resolve(chunks.join("")));
    process.stdin.on("error", reject);
  });
}

// ─── Tool Definitions ───────────────────────────────────────────────────────
//
// Mirrors OpenClaw's agents/tools/* — each tool is { spec, execute }.
// spec is OpenAI function-calling schema; execute returns a string result.
//

const { execSync } = require("child_process");
const fs = require("fs");
const path = require("path");
const https = require("https");
const http = require("http");

const TOOLS = {
  shell: {
    spec: {
      type: "function",
      function: {
        name: "shell",
        description:
          "Execute a shell command and return its stdout+stderr. " +
          "Use bash on unix, cmd on windows. Timeout: 30s.",
        parameters: {
          type: "object",
          properties: {
            command: { type: "string", description: "The shell command to run." },
          },
          required: ["command"],
        },
      },
    },
    execute(args) {
      const cmd = args.command;
      if (!cmd) return JSON.stringify({ error: "missing command" });
      log("tool:shell →", cmd);
      try {
        const out = execSync(cmd, {
          encoding: "utf8",
          timeout: 30_000,
          maxBuffer: 1024 * 1024,
          stdio: ["pipe", "pipe", "pipe"],
        });
        const trimmed = out.length > 20000 ? out.slice(0, 20000) + "\n...[truncated]" : out;
        return trimmed;
      } catch (e) {
        const stderr = e.stderr ? e.stderr.toString().slice(0, 5000) : "";
        const stdout = e.stdout ? e.stdout.toString().slice(0, 5000) : "";
        return JSON.stringify({
          exitCode: e.status,
          stdout: stdout,
          stderr: stderr,
          error: e.message.slice(0, 500),
        });
      }
    },
  },

  fetch: {
    spec: {
      type: "function",
      function: {
        name: "fetch",
        description:
          "HTTP request. Returns status, headers, and body. " +
          "Supports GET/POST/PUT/DELETE. Body truncated to 30k chars.",
        parameters: {
          type: "object",
          properties: {
            url: { type: "string", description: "URL to fetch." },
            method: { type: "string", description: "HTTP method. Default GET.", enum: ["GET", "POST", "PUT", "DELETE", "PATCH", "HEAD"] },
            headers: { type: "object", description: "HTTP headers.", additionalProperties: { type: "string" } },
            body: { type: "string", description: "Request body for POST/PUT/PATCH." },
          },
          required: ["url"],
        },
      },
    },
    async execute(args) {
      const url = args.url;
      if (!url) return JSON.stringify({ error: "missing url" });
      log("tool:fetch →", args.method || "GET", url);
      try {
        const resp = await httpFetch(url, {
          method: args.method || "GET",
          headers: args.headers || {},
          body: args.body,
          timeout: 15_000,
        });
        let body = resp.body;
        if (body.length > 30000) body = body.slice(0, 30000) + "\n...[truncated]";
        return JSON.stringify({ status: resp.status, contentType: resp.contentType, body });
      } catch (e) {
        return JSON.stringify({ error: e.message });
      }
    },
  },

  datetime: {
    spec: {
      type: "function",
      function: {
        name: "datetime",
        description: "Get current date/time. Optionally specify timezone (IANA name).",
        parameters: {
          type: "object",
          properties: {
            timezone: { type: "string", description: 'Timezone, e.g. "Asia/Shanghai". Default UTC.' },
          },
        },
      },
    },
    execute(args) {
      const tz = args.timezone || "UTC";
      try {
        const now = new Date();
        const fmt = new Intl.DateTimeFormat("en-US", {
          timeZone: tz, year: "numeric", month: "long", day: "numeric",
          weekday: "long", hour: "2-digit", minute: "2-digit", second: "2-digit",
          hourCycle: "h23", timeZoneName: "longOffset",
        });
        return JSON.stringify({ iso: now.toISOString(), formatted: fmt.format(now), timezone: tz, unix: Math.floor(now.getTime() / 1000) });
      } catch (e) {
        return JSON.stringify({ error: e.message });
      }
    },
  },

  calculate: {
    spec: {
      type: "function",
      function: {
        name: "calculate",
        description: "Evaluate a math expression. Supports +, -, *, /, **, %, sqrt, sin, cos, log, PI, E, etc.",
        parameters: {
          type: "object",
          properties: {
            expression: { type: "string", description: 'Math expression, e.g. "sqrt(144) + 3 * 7".' },
          },
          required: ["expression"],
        },
      },
    },
    execute(args) {
      const expr = args.expression;
      if (!expr) return JSON.stringify({ error: "missing expression" });
      try {
        const mathCtx = {
          sqrt: Math.sqrt, abs: Math.abs, ceil: Math.ceil, floor: Math.floor,
          round: Math.round, sin: Math.sin, cos: Math.cos, tan: Math.tan,
          log: Math.log, log2: Math.log2, log10: Math.log10, exp: Math.exp,
          pow: Math.pow, min: Math.min, max: Math.max, PI: Math.PI, E: Math.E,
        };
        let e = expr;
        for (const k of Object.keys(mathCtx)) e = e.replace(new RegExp("\\b" + k + "\\b", "g"), "__m." + k);
        if (/[;{}[\]\\`'"$]/.test(e) || /\b(function|return|var|let|const|import|require|eval)\b/.test(e))
          return JSON.stringify({ error: "disallowed expression" });
        const fn = new Function("__m", '"use strict"; return (' + e + ");");
        const r = fn(mathCtx);
        return JSON.stringify({ expression: expr, result: r });
      } catch (e) {
        return JSON.stringify({ error: e.message });
      }
    },
  },

  read_file: {
    spec: {
      type: "function",
      function: {
        name: "read_file",
        description: "Read a file from disk. Returns its text content (truncated to 50k chars).",
        parameters: {
          type: "object",
          properties: {
            path: { type: "string", description: "Absolute or relative file path." },
          },
          required: ["path"],
        },
      },
    },
    execute(args) {
      try {
        const p = path.resolve(args.path);
        log("tool:read_file →", p);
        const content = fs.readFileSync(p, "utf8");
        if (content.length > 50000) return content.slice(0, 50000) + "\n...[truncated]";
        return content;
      } catch (e) {
        return JSON.stringify({ error: e.message });
      }
    },
  },

  write_file: {
    spec: {
      type: "function",
      function: {
        name: "write_file",
        description: "Write text content to a file. Creates parent directories if needed.",
        parameters: {
          type: "object",
          properties: {
            path: { type: "string", description: "File path." },
            content: { type: "string", description: "Content to write." },
          },
          required: ["path", "content"],
        },
      },
    },
    execute(args) {
      try {
        const p = path.resolve(args.path);
        log("tool:write_file →", p);
        fs.mkdirSync(path.dirname(p), { recursive: true });
        fs.writeFileSync(p, args.content, "utf8");
        return JSON.stringify({ ok: true, path: p, bytes: Buffer.byteLength(args.content) });
      } catch (e) {
        return JSON.stringify({ error: e.message });
      }
    },
  },

  ls: {
    spec: {
      type: "function",
      function: {
        name: "ls",
        description: "List directory contents. Returns filenames with type indicators (/ for dirs).",
        parameters: {
          type: "object",
          properties: {
            path: { type: "string", description: "Directory path. Default: current directory." },
          },
        },
      },
    },
    execute(args) {
      try {
        const dir = path.resolve(args.path || ".");
        log("tool:ls →", dir);
        const entries = fs.readdirSync(dir, { withFileTypes: true });
        const list = entries.map((e) => e.name + (e.isDirectory() ? "/" : ""));
        return list.join("\n");
      } catch (e) {
        return JSON.stringify({ error: e.message });
      }
    },
  },
};

// ─── HTTP fetch (Node.js built-in, no dependencies) ────────────────────────

function httpFetch(url, opts = {}) {
  return new Promise((resolve, reject) => {
    const parsed = new URL(url);
    const mod = parsed.protocol === "https:" ? https : http;
    const reqOpts = {
      method: opts.method || "GET",
      headers: { "User-Agent": "ailoop/1.0", ...(opts.headers || {}) },
      timeout: opts.timeout || 15000,
    };
    const req = mod.request(url, reqOpts, (res) => {
      const chunks = [];
      res.setEncoding("utf8");
      res.on("data", (c) => chunks.push(c));
      res.on("end", () => {
        // Follow redirects (3xx)
        if (res.statusCode >= 300 && res.statusCode < 400 && res.headers.location) {
          httpFetch(new URL(res.headers.location, url).href, opts).then(resolve, reject);
          return;
        }
        resolve({
          status: res.statusCode,
          contentType: res.headers["content-type"] || "",
          body: chunks.join(""),
        });
      });
    });
    req.on("timeout", () => { req.destroy(); reject(new Error("Request timed out")); });
    req.on("error", reject);
    if (opts.body && ["POST", "PUT", "PATCH"].includes((opts.method || "").toUpperCase())) {
      req.write(opts.body);
    }
    req.end();
  });
}

// ─── OpenAI-compatible API client ───────────────────────────────────────────
//
// Ollama exposes /v1/chat/completions (OpenAI-compatible).
// This works with Ollama, OpenAI, vLLM, LM Studio, etc.
//

async function chatCompletion(baseUrl, apiKey, model, messages, tools) {
  const url = baseUrl.replace(/\/+$/, "") + "/chat/completions";
  const body = JSON.stringify({
    model,
    messages,
    tools: tools.length > 0 ? tools : undefined,
    temperature: 0.7,
    stream: false,
  });

  log("api call →", url, "model=" + model, "msgs=" + messages.length);

  const headers = { "Content-Type": "application/json" };
  if (apiKey) headers["Authorization"] = "Bearer " + apiKey;

  const resp = await httpFetch(url, { method: "POST", headers, body, timeout: 120_000 });

  if (resp.status !== 200) {
    throw new Error("API error " + resp.status + ": " + resp.body.slice(0, 1000));
  }

  let data;
  try {
    data = JSON.parse(resp.body);
  } catch (e) {
    throw new Error("API returned non-JSON: " + resp.body.slice(0, 500));
  }
  return data;
}

// ─── Core Agent Loop ────────────────────────────────────────────────────────
//
// This is the extracted core of OpenClaw's agent execution:
//
//   OpenClaw: runEmbeddedPiAgent()  →  runEmbeddedAttempt()  →  subscribeEmbeddedPiSession()
//            └─ tool call loop: model responds with tool_calls → execute → feed back → repeat
//
// Simplified to the essential loop:
//
//   while (round < maxRounds) {
//     response = callModel(messages)
//     if response has tool_calls:
//       for each tool_call: execute tool, append result
//     else:
//       return response text
//   }
//

async function runAgentLoop(config, taskMessage) {
  const { baseUrl, apiKey, model, maxRounds, timeoutMs } = config;
  const startedAt = Date.now();

  // Build tool specs array for the API
  const toolSpecs = Object.values(TOOLS).map((t) => t.spec);

  // Session messages — corresponds to OpenClaw's SessionManager
  const messages = [
    {
      role: "system",
      content:
        "You are a capable AI assistant. Complete the user's task thoroughly.\n" +
        "Use the provided tools when they help. Be concise in your final answer.\n" +
        "Current time: " + new Date().toISOString() + " UTC",
    },
    {
      role: "user",
      content: taskMessage,
    },
  ];

  let round = 0;
  let totalToolCalls = 0;

  while (round < maxRounds) {
    round++;

    // Timeout guard — corresponds to OpenClaw's resolveAgentTimeoutMs
    if (Date.now() - startedAt > timeoutMs) {
      die("Agent timed out after " + ((Date.now() - startedAt) / 1000).toFixed(1) + "s");
    }

    // Call the model — corresponds to OpenClaw's streamSimple / createAgentSession
    let response;
    try {
      response = await chatCompletion(baseUrl, apiKey, model, messages, toolSpecs);
    } catch (e) {
      // Corresponds to OpenClaw's failover-error.ts error classification
      if (e.message.includes("429")) die("Rate limited. Retry later.");
      if (e.message.includes("401") || e.message.includes("403")) die("Auth failed. Check API key.");
      die("API call failed: " + e.message);
    }

    const choice = response.choices && response.choices[0];
    if (!choice) die("API returned no choices: " + JSON.stringify(response).slice(0, 500));

    const msg = choice.message;

    // Append assistant message to history
    messages.push(msg);

    const toolCalls = msg.tool_calls;

    // No tool calls → final text response
    if (!toolCalls || toolCalls.length === 0) {
      const text = msg.content || "";
      log("round " + round + ": final response (" + text.length + " chars)");

      // Usage tracking — corresponds to OpenClaw's normalizeUsage
      const usage = response.usage;
      if (usage) {
        log(
          "tokens: prompt=" + (usage.prompt_tokens || 0) +
          " completion=" + (usage.completion_tokens || 0) +
          " total=" + (usage.total_tokens || 0)
        );
      }

      return {
        text,
        rounds: round,
        toolCalls: totalToolCalls,
        usage: usage || null,
        durationMs: Date.now() - startedAt,
      };
    }

    // Execute tool calls — corresponds to OpenClaw's pi-embedded-subscribe.handlers.tools.ts
    log("round " + round + ": " + toolCalls.length + " tool call(s)");

    for (const tc of toolCalls) {
      totalToolCalls++;
      const fnName = tc.function.name;
      let fnArgs;
      try {
        fnArgs = typeof tc.function.arguments === "string"
          ? JSON.parse(tc.function.arguments)
          : tc.function.arguments || {};
      } catch {
        fnArgs = {};
      }

      const tool = TOOLS[fnName];
      let result;
      if (!tool) {
        result = JSON.stringify({ error: "Unknown tool: " + fnName });
        log("tool:UNKNOWN →", fnName);
      } else {
        const toolStart = Date.now();
        try {
          result = await tool.execute(fnArgs);
        } catch (e) {
          result = JSON.stringify({ error: "Tool failed: " + e.message });
        }
        const toolMs = Date.now() - toolStart;
        log("tool:" + fnName + " done (" + toolMs + "ms, " + (result || "").length + " chars)");
      }

      // Feed tool result back — corresponds to OpenClaw appending tool results to session
      messages.push({
        role: "tool",
        tool_call_id: tc.id,
        content: typeof result === "string" ? result : JSON.stringify(result),
      });
    }
  }

  die("Reached max tool-call rounds (" + maxRounds + ") without final answer");
}

// ─── Main ───────────────────────────────────────────────────────────────────

async function main() {
  const args = parseArgs(process.argv);

  const ollamaHost = (process.env.OLLAMA_HOST || "http://localhost:11434").replace(/\/+$/, "");

  const baseUrl = args.baseUrl || process.env.OPENAI_BASE_URL || ollamaHost + "/v1";
  const apiKey = args.apiKey || process.env.OPENAI_API_KEY || "";
  const model = args.model || process.env.AILOOP_MODEL || "qwen3:8b";
  const maxRounds = args.maxRounds || parseInt(process.env.AILOOP_MAX_ROUNDS || "15", 10);
  const timeoutSec = args.timeout || parseInt(process.env.AILOOP_TIMEOUT || "300", 10);

  log("config: model=" + model + " baseUrl=" + baseUrl + " maxRounds=" + maxRounds + " timeout=" + timeoutSec + "s");

  // Read task from stdin — corresponds to OpenClaw inbound message processing
  const input = await readStdin();
  const taskMessage = input.trim();
  if (!taskMessage) die("Empty input. Provide a task message on stdin.");

  log("task: " + taskMessage.slice(0, 200) + (taskMessage.length > 200 ? "..." : ""));

  // Run the agent loop — corresponds to OpenClaw's runEmbeddedPiAgent → runEmbeddedAttempt
  const result = await runAgentLoop(
    { baseUrl, apiKey, model, maxRounds, timeoutMs: timeoutSec * 1000 },
    taskMessage,
  );

  // Print final result to stdout — corresponds to OpenClaw's outbound delivery
  process.stdout.write(result.text);

  // Print metadata to stderr if verbose
  if (process.env.AILOOP_VERBOSE === "1") {
    process.stderr.write(
      "\n---\n" +
      "rounds: " + result.rounds + "\n" +
      "tool_calls: " + result.toolCalls + "\n" +
      "duration: " + (result.durationMs / 1000).toFixed(1) + "s\n" +
      (result.usage
        ? "tokens: " + (result.usage.prompt_tokens || 0) + " in / " + (result.usage.completion_tokens || 0) + " out\n"
        : "")
    );
  }
}

main().catch((e) => {
  process.stderr.write("fatal: " + e.message + "\n");
  process.exit(1);
});
